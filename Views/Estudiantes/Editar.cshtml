@model Sistema_Academico.Models.Estudiante
@{
    ViewData["Title"] = "Editar Estudiante";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-pencil me-2 text-primary"></i>Editar – @Model.NombreCompleto
            </div>
            <div class="card-body p-4">
                <form asp-action="Editar" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Nombre" class="form-label"></label>
                            <input asp-for="Nombre" class="form-control" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Apellido" class="form-label"></label>
                            <input asp-for="Apellido" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Codigo" class="form-label"></label>
                            <input asp-for="Codigo" class="form-control" />
                            <span asp-validation-for="Codigo" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Correo" class="form-label"></label>
                            <input asp-for="Correo" class="form-control" type="email" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Semestre" class="form-label"></label>
                            <input asp-for="Semestre" class="form-control"
                                   type="number" min="1" max="12" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="UsuarioId" class="form-label">
                                Usuario vinculado
                            </label>
                            <select asp-for="UsuarioId" class="form-select"
                                    asp-items="ViewBag.UsuarioId">
                                <option value="">— Ninguno —</option>
                            </select>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i>Guardar cambios
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>