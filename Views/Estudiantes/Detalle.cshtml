@model Sistema_Academico.Models.Estudiante
@{
    ViewData["Title"] = "Detalle Estudiante";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-header">
                <i class="bi bi-person me-2 text-primary"></i>@Model.NombreCompleto
            </div>
            <div class="card-body p-4">
                <dl class="row">
                    <dt class="col-4">Código</dt>
                    <dd class="col-8"><code>@Model.Codigo</code></dd>
                    <dt class="col-4">Correo</dt>
                    <dd class="col-8">@Model.Correo</dd>
                    <dt class="col-4">Semestre</dt>
                    <dd class="col-8">@(Model.Semestre.HasValue ? Model.Semestre.ToString() : "–")</dd>
                    <dt class="col-4">Usuario</dt>
                    <dd class="col-8">@(Model.Usuario?.NombreUsuario ?? "Sin vincular")</dd>
                </dl>
            </div>
        </div>

        @if (Model.Notas.Any())
        {
            <div class="card">
                <div class="card-header">
                    Notas registradas (@Model.Notas.Count) —
                    Promedio:
                    <strong class="@(Model.Notas.Average(n => n.Valor) >= 3 ? "text-success" : "text-danger")">
                        @Model.Notas.Average(n => n.Valor).ToString("F2")
                    </strong>
                </div>
                <div class="card-body p-0">
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>Materia</th>
                                <th>Período</th>
                                <th>Nota</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var n in Model.Notas.OrderBy(n => n.Materia?.Nombre))
                            {
                                string cls = n.Valor >= 4 ? "nota-badge badge-nota-alta"
                                             : n.Valor >= 3 ? "nota-badge badge-nota-media"
                                             : "nota-badge badge-nota-baja";
                                string estado = n.Valor >= 3 ? "Aprobó" : "Reprobó";
                                string estCls = n.Valor >= 3 ? "text-success" : "text-danger";
                                <tr>
                                    <td>@n.Materia?.Nombre</td>
                                    <td>@n.Periodo</td>
                                    <td><span class="@cls">@n.Valor.ToString("F2")</span></td>
                                    <td class="@estCls fw-semibold">@estado</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info">Sin notas registradas aún.</div>
        }

        <div class="mt-3">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Volver
            </a>
        </div>
    </div>
</div>