@model Sistema_Academico.Models.Docente
@{
    ViewData["Title"] = "Eliminar Docente";
}
<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="card border-danger">
            <div class="card-header text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Confirmar Eliminación</div>
            <div class="card-body p-4">
                <p>¿Eliminar al docente <strong>@Model.NombreCompleto</strong>?</p>
                <dl class="row small mb-3">
                    <dt class="col-4">Correo</dt>
                    <dd class="col-8">@Model.Correo</dd>
                    <dt class="col-4">Especialidad</dt>
                    <dd class="col-8">@Model.Especialidad</dd>
                    <dt class="col-4">Materias</dt>
                    <dd class="col-8">@Model.Materias.Count asignadas</dd>
                </dl>
                <div class="alert alert-warning py-2 small">Las materias quedarán sin docente asignado.</div>
                <form asp-action="Eliminar" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Eliminar</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>