@model Sistema_Academico.Models.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Login – Sistema Académico</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <style>
            body {
                font-family: 'Plus Jakarta Sans',sans-serif;
                background: linear-gradient(135deg,#0f172a,#1e3a5f,#0f172a);
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .login-card {
                background: #fff;
                border-radius: 20px;
                padding: 40px;
                box-shadow: 0 25px 60px rgba(0,0,0,.35);
                width: 100%;
                max-width: 420px;
            }

            .logo-circle {
                width: 64px;
                height: 64px;
                background: #1a56db;
                border-radius: 18px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }

            .form-control {
                border: 1.5px solid #e2e8f0;
                border-radius: 10px;
                padding: 11px 14px 11px 38px;
                font-size: 14px;
            }

                .form-control:focus {
                    border-color: #1a56db;
                    box-shadow: 0 0 0 3px rgba(26,86,219,.12);
                }

            .input-wrap {
                position: relative;
            }

                .input-wrap i {
                    position: absolute;
                    left: 13px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: #94a3b8;
                }

            .btn-login {
                width: 100%;
                background: #1a56db;
                color: #fff;
                border: none;
                border-radius: 10px;
                padding: 13px;
                font-size: 15px;
                font-weight: 700;
            }

                .btn-login:hover {
                    background: #1342b5;
                    color: #fff;
                }

            .demo-box {
                background: #f8fafc;
                border: 1px solid #e2e8f0;
                border-radius: 10px;
                padding: 12px 16px;
                font-size: 12px;
                color: #64748b;
                margin-top: 20px;
            }
    </style>
</head>
<body>
    <div style="padding:16px; width:100%; display:flex; justify-content:center;">
        <div class="login-card">
            <div class="text-center mb-4">
                <div class="logo-circle mb-3"><i class="bi bi-mortarboard-fill text-white fs-3"></i></div>
                <h1 style="font-size:22px;font-weight:800;color:#0f172a">Sistema Académico</h1>
                <p style="color:#64748b;font-size:13px">Gestión Integral de Calificaciones</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 mb-3" style="font-size:13px;border-radius:10px">
                    @Html.ValidationSummary(true)
                </div>
            }

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label fw-semibold" style="font-size:13px">Usuario</label>
                    <div class="input-wrap">
                        <i class="bi bi-person"></i>
                        <input asp-for="NombreUsuario" class="form-control" placeholder="nombre de usuario" />
                    </div>
                    <span asp-validation-for="NombreUsuario" class="text-danger" style="font-size:12px"></span>
                </div>
                <div class="mb-4">
                    <label class="form-label fw-semibold" style="font-size:13px">Contraseña</label>
                    <div class="input-wrap">
                        <i class="bi bi-lock"></i>
                        <input asp-for="Contrasena" type="password" class="form-control" placeholder="contraseña" />
                    </div>
                    <span asp-validation-for="Contrasena" class="text-danger" style="font-size:12px"></span>
                </div>
                <button type="submit" class="btn btn-login">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Ingresar
                </button>
            </form>

            <div class="demo-box">
                <strong style="color:#374151">Primer ingreso — crea tu admin así:</strong><br />
                Ve a <code>Usuarios → Crear</code> después de ejecutar la app, o inserta directamente en BD con rol <code>Admin</code>.
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>