@model IEnumerable<Sistema_Academico.Models.MovimientoNota>
@{
    ViewData["Title"] = "Movimiento_notas";
}

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label mb-1">Tipo</label>
                <select name="tipo" class="form-select">
                    <option value="">Todos</option>
                    <option value="Insercion"
                            selected="@(ViewBag.Tipo == "Insercion" ? "selected" : null)">
                        Inserción
                    </option>
                    <option value="Modificacion"
                            selected="@(ViewBag.Tipo == "Modificacion" ? "selected" : null)">
                        Modificación
                    </option>
                    <option value="Eliminacion"
                            selected="@(ViewBag.Tipo == "Eliminacion" ? "selected" : null)">
                        Eliminación
                    </option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label mb-1">Estudiante</label>
                <select name="estudianteId" class="form-select" asp-items="ViewBag.Estudiantes">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label mb-1">Materia</label>
                <select name="materiaId" class="form-select" asp-items="ViewBag.Materias">
                    <option value="">Todas</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label mb-1">Desde</label>
                <input type="date" name="desde" value="@ViewBag.Desde" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label mb-1">Hasta</label>
                <input type="date" name="hasta" value="@ViewBag.Hasta" class="form-control" />
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search me-1"></i>Buscar
                </button>
                <a asp-action="MovimientoNotas" class="btn btn-outline-secondary ms-1">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">@Model.Count() movimientos encontrados</div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Tipo</th>
                        <th>Estudiante</th>
                        <th>Materia</th>
                        <th>Período</th>
                        <th>Valor Ant.</th>
                        <th>Valor Nuevo</th>
                        <th>Usuario</th>
                        <th>Fecha</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model)
                    {
                        string badgeCls = m.TipoMovimiento == "Insercion" ? "bg-success bg-opacity-10 text-success"
                                        : m.TipoMovimiento == "Eliminacion" ? "bg-danger bg-opacity-10 text-danger"
                                        : "bg-warning bg-opacity-10 text-warning";
                        string ico = m.TipoMovimiento == "Insercion" ? "bi-plus-circle"
                                        : m.TipoMovimiento == "Eliminacion" ? "bi-dash-circle"
                                        : "bi-pencil";
                        <tr>
                            <td class="text-muted">@m.Id</td>
                            <td>
                                <span class="badge @badgeCls">
                                    <i class="bi @ico me-1"></i>@m.TipoMovimiento
                                </span>
                            </td>
                            <td>@m.Estudiante?.NombreCompleto</td>
                            <td>@m.Materia?.Nombre</td>
                            <td>@m.Periodo</td>
                            <td>@(m.ValorAnterior.HasValue ? m.ValorAnterior.Value.ToString("F2") : "–")</td>
                            <td>@(m.ValorNuevo.HasValue ? m.ValorNuevo.Value.ToString("F2") : "–")</td>
                            <td class="text-muted" style="font-size:13px">@m.UsuarioAccion</td>
                            <td class="text-muted" style="font-size:13px">
                                @m.FechaMovimiento.ToString("dd/MM/yyyy HH:mm")
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">
                                No se encontraron movimientos.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>