@model Sistema_Academico.Models.Nota
@{
    ViewData["Title"] = "Editar Nota";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-pencil me-2 text-primary"></i>Editar Nota #@Model.Id
            </div>
            <div class="card-body p-4">
                <form asp-action="Editar" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="FechaRegistro" />
                    <div class="mb-3">
                        <label asp-for="EstudianteId" class="form-label">Estudiante</label>
                        <select asp-for="EstudianteId" class="form-select" asp-items="ViewBag.EstudianteId">
                            <option value="">— Seleccione —</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="MateriaId" class="form-label">Materia</label>
                        <select asp-for="MateriaId" class="form-select" asp-items="ViewBag.MateriaId">
                            <option value="">— Seleccione —</option>
                        </select>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label asp-for="Valor" class="form-label">Nota (0 – 5)</label>
                            <input asp-for="Valor" class="form-control"
                                   type="number" step="0.01" min="0" max="5" />
                            <span asp-validation-for="Valor" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="Periodo" class="form-label">Período</label>
                            <input asp-for="Periodo" class="form-control" />
                            <span asp-validation-for="Periodo" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Observaciones" class="form-label">Observaciones</label>
                        <input asp-for="Observaciones" class="form-control" />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i>Guardar cambios
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>